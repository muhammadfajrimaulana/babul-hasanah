# Contoh konfigurasi lingkungan.
# Salin ke .env lalu isi nilai sensitif: cp .env.example .env
# Jangan commit .env / Client Secret / password SMTP ke repositori.

APP_NAME="Pondok Pesantren Babul Hasanah"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Jinakkan format tanggal & pesan validasi Bahasa Indonesia.
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Isi setelah membuat OAuth client di Google Cloud Console.
# Biarkan kosong untuk menyembunyikan tombol Google Login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opsional. Kosong berarti memakai url('/auth/google/callback').
GOOGLE_REDIRECT_URI=
# Opsional. Path CA bundle untuk cURL; kosong memakai storage/certs/cacert.pem.
GOOGLE_CA_BUNDLE=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=babul_hasanah
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Sengaja dikunci agar mengganti APP_NAME tidak memutus sesi pengguna.
SESSION_COOKIE=laravel-session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Produksi: isi SMTP asli dan jangan commit passwordnya.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SCHEME=null
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Pondok Pesantren Babul Hasanah"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
